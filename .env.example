# Salin file ini menjadi .env dan isi dengan nilai API key Anda
# Copy this file to .env and fill in your actual API key values

PORT=3000

# MAPID Routing API Key
# Dapatkan di: https://mapid.io
MAPID_API_KEY=your_mapid_api_key_here

# OpenRouteService API Key (digunakan sebagai fallback isochrone)
# Dapatkan di: https://openrouteservice.org/dev/#/signup
ORS_API_KEY=your_openrouteservice_api_key_here
